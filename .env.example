# App
NEXT_PUBLIC_APP_URL=https://avaliaprudente.com.br
NODE_ENV=production

# Supabase Cloud (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
NEXT_PUBLIC_AUTH_CALLBACK_URL=https://avaliaprudente.com.br/auth/callback

# Redis
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Security & Cryptography (Required in production: minimum 32 characters)
# Note: SUDO_SECRET is completely independent from SUPABASE_SERVICE_ROLE_KEY and strictly required in production
SUDO_SECRET=your-minimum-32-character-sudo-secret-here
FINGERPRINT_PEPPER=your-minimum-32-character-fingerprint-pepper-here